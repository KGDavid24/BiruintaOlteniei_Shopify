    },
    {
      "type": "richtext",
      "id": "extra_text",
      "label": "Extra intro text",
      "default": "<p>Fie că dorești informații despre produse, ajutor pentru o comandă sau detalii despre colaborări, îtsí stăm la dispoziție. Ne dorim să oferim răspunsuri clare, utile și rapide, astfel încât să poți lua decizia potrivită fără bătăi de cap.</p>"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Telefon"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+40 778 748 196"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Program de răspuns"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Luni – Vineri, 09:00 – 17:00"
    },
    {
      "type": "text",
      "id": "response_label",
      "label": "Response time label",
      "default": "Timp estimat de răspuns"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time",
      "default": "În maximum 1 zi lucrătoare"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address label",
      "default": "Adresă"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "topics_heading",
      "label": "Topics heading",
      "default": "Ne poți contacta pentru"
    },
    {
      "type": "text",
      "id": "topic_1",
      "label": "Topic 1",
      "default": "informații despre produse"
    },
    {
      "type": "text",
      "id": "topic_2",
      "label": "Topic 2",
      "default": "ajutor legat de comenzi"
    },
    {
      "type": "text",
      "id": "topic_3",
      "label": "Topic 3",
      "default": "întrebări despre livrare"
    },
    {
      "type": "text",
      "id": "topic_4",
      "label": "Topic 4",
      "default": "colaborări și parteneriate"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help heading",
      "default": "Înainte să ne scrii"

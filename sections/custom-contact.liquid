      "default": "Date companie"
    },
    {
      "type": "richtext",
      "id": "company_details",
      "label": "Company details"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Nume"
    },
    {
      "type": "text",
      "id": "email_form_label",
      "label": "Form email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_form_label",
      "label": "Form phone label",
      "default": "Telefon"
    },
    {
      "type": "text",
      "id": "subject_label",
      "label": "Subject label",
      "default": "Subiect"
    },
    {
      "type": "text",
      "id": "message_label",

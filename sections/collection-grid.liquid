{% assign section_id = section.id | replace: '-', '_' %}

{% style %}
  /* --- 1. KERET ÉS ELRENDEZÉS (1400px) --- */
  .custom-flour-section-{{ section_id }} {
    display: block;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: #ffffff;
    box-sizing: border-box;
  }

  .custom-flour-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  /* --- 2. TERMÉK KÁRTYA --- */
  .flour-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    padding: 0;
    position: relative;
    height: 100%;
  }

  /* Kép */
  .flour-card__media-{{ section_id }} {
    position: relative;
    width: 100%;
    margin-bottom: 15px;
    overflow: hidden;
    aspect-ratio: 1 / 1.1;
  }

  .flour-card__link-{{ section_id }} {
    text-decoration: none;
    display: block;
    width: 100%;
    height: 100%;
  }

  .flour-card__img-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  
  .flour-card__link-{{ section_id }}:hover .flour-card__img-{{ section_id }} {
    transform: scale(1.03);
  }

  /* Cím */
  .flour-card__title-{{ section_id }} {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.3;
    color: #4a3b32;
    text-align: left;
  }

  .flour-card__title-link-{{ section_id }} {
    text-decoration: none;
    color: inherit;
  }

  /* Árak */
  .flour-card__price-box-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    flex-wrap: wrap;
    min-height: 27px;
  }

  .flour-card__compare-{{ section_id }} {
    font-size: 16px;
    text-decoration: line-through;
    color: #999999;
  }

  .flour-card__price-{{ section_id }} {
    font-size: 20px;
    font-weight: 800;
    color: #4a3b32;
  }

  .flour-card__badge-{{ section_id }} {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    background-color: #d32f2f;
    padding: 4px 8px;
    border-radius: 4px;
    margin-left: 5px;
  }

  /* Variáns Választó (Pills) */
  .flour-card__actions-{{ section_id }} {
    margin-top: auto;
    display: flex;
    flex-direction: column;
  }
  
  .flour-card__label-{{ section_id }} {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 10px;
    color: #4a3b32;
    display: block;
    text-align: left;
  }

  .flour-card__pills-{{ section_id }} {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .flour-card__pill-btn-{{ section_id }} {
    padding: 8px 24px;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    background-color: #ffffff;
    color: #4a3b32;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    transition: all 0.2s ease;
    min-width: 70px;
    text-align: center;
  }

  .flour-card__pill-btn-{{ section_id }}:hover {
    border-color: #eebf4d;
  }

  .flour-card__pill-btn-{{ section_id }}.is-active {
    background-color: #eebf4d;
    border-color: #eebf4d;
    color: #ffffff;
  }

  /* --- 3. EGYSÉGES GOMBOK --- */
  .flour-card__btn-{{ section_id }} {
    width: 100%;
    height: 50px; /* Fix magasság */
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #72bf4e;
    color: #ffffff;
    border: none;
    border-radius: 30px;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
    box-sizing: border-box;
    margin-top: auto;
    line-height: 1;
    padding: 0 20px;
  }

  .flour-card__btn-{{ section_id }}:hover {
    background-color: #64a844;
  }
  
  .flour-card__btn-{{ section_id }}:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  /* MODOSITVA: Pachet üzenet stílusa - Sima szöveg, Sima keret */
  .flour-card__pkg-msg-{{ section_id }} {
    color: #4a3b32;
    font-style: normal; /* NEM dőlt */
    font-weight: 400;   /* Normál vastagság */
    margin-bottom: 15px;
    font-size: 14px;
    background: #f9f9f9;
    padding: 10px;
    border-radius: 8px;
    text-align: center;
    border: 1px solid #e0e0e0; /* Solid border */
  }
  
  .flour-spacer-{{ section_id }} { height: 20px; width: 100%; }

  /* Responsive */
  @media screen and (max-width: 1100px) {
    .custom-flour-grid-{{ section_id }} { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
  @media screen and (max-width: 768px) {
    .custom-flour-grid-{{ section_id }} { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  }
  @media screen and (max-width: 500px) {
    .custom-flour-grid-{{ section_id }} { grid-template-columns: 1fr; }
    .custom-flour-section-{{ section_id }} { padding: 20px; }
  }
{% endstyle %}

<div class="custom-flour-section-{{ section_id }}">
  <div class="custom-flour-grid-{{ section_id }}">
    {%- if section.settings.collection_handle != blank -%}
      {%- assign target_collection = collections[section.settings.collection_handle] -%}
    {%- else -%}
      {%- assign target_collection = blank -%}
    {%- endif -%}
    
    {% if target_collection != blank %}
      {% for product in target_collection.products limit: 50 %}
        
        <div class="flour-card-{{ section_id }}" data-product-card>
          
          <div class="flour-card__media-{{ section_id }}">
            <a href="{{ product.url }}" class="flour-card__link-{{ section_id }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" 
                     alt="{{ product.featured_image.alt | escape }}" 
                     class="flour-card__img-{{ section_id }}" 
                     loading="lazy" width="600" height="600">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'flour-card__img-' | append: section_id }}
              {% endif %}
            </a>
          </div>

          <h3 class="flour-card__title-{{ section_id }}">
            <a href="{{ product.url }}" class="flour-card__title-link-{{ section_id }}">{{ product.title }}</a>
          </h3>

          {% assign current_variant = product.selected_or_first_available_variant %}

          <div class="flour-card__price-box-{{ section_id }}" data-price-box>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="flour-card__compare-{{ section_id }}">{{ current_variant.compare_at_price | money }}</span>
              <span class="flour-card__price-{{ section_id }}">{{ current_variant.price | money }}</span>
              {% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
              {% assign savings_rounded = savings | divided_by: 100.0 | ceil | times: 100 %}
              <span class="flour-card__badge-{{ section_id }}">
                {% if request.locale.iso_code == 'en' %}You save{% else %}Economisești{% endif %} {{ savings_rounded | money_without_trailing_zeros }}
              </span>
            {% else %}
              <span class="flour-card__price-{{ section_id }}">{{ current_variant.price | money }}</span>
            {% endif %}
          </div>

          <div class="flour-card__actions-{{ section_id }}">
            
            {% if product.title contains 'Pachet' or product.title contains 'Package' %}
               <label class="flour-card__label-{{ section_id }}">{% if request.locale.iso_code == 'en' %}Options:{% else %}Opțiuni:{% endif %}</label>
               <div class="flour-card__pkg-msg-{{ section_id }}">
                  {{ product.variants.size }} {% if request.locale.iso_code == 'en' %}options available{% else %}opțiuni disponibile{% endif %}
               </div>
               <div style="flex-grow: 1;"></div>
               <a href="{{ product.url }}" class="flour-card__btn-{{ section_id }}">{% if request.locale.iso_code == 'en' %}View options{% else %}Vezi opțiunile{% endif %}</a>

            {% else %}
               <form method="post" action="/cart/add" class="flour-product-form-{{ section_id }}">
                 <input type="hidden" name="id" value="{{ current_variant.id }}" class="flour-variant-input-{{ section_id }}">
                 
                 {% unless product.has_only_default_variant %}
                   <label class="flour-card__label-{{ section_id }}">{% if request.locale.iso_code == 'en' %}Packages:{% else %}Pachete:{% endif %}</label>
                   <div class="flour-card__pills-{{ section_id }}">
                      {% for variant in product.variants %}
                        <button type="button" 
                                class="flour-card__pill-btn-{{ section_id }} {% if variant.id == current_variant.id %}is-active{% endif %}"
                                data-variant-id="{{ variant.id }}"
                                data-price="{{ variant.price | money }}"
                                data-compare="{{ variant.compare_at_price | money }}"
                                data-raw-price="{{ variant.price }}"
                                data-raw-compare="{{ variant.compare_at_price }}"
                                data-available="{{ variant.available }}">
                          {{ variant.title }}
                        </button>
                      {% endfor %}
                   </div>
                 {% else %}
                    <div class="flour-spacer-{{ section_id }}"></div>
                    <div style="height: 56px;"></div>
                 {% endunless %}
                 
                 <div style="flex-grow: 1;"></div>
                 
                 <button type="submit" name="add" class="flour-card__btn-{{ section_id }}" 
                         {% unless current_variant.available %}disabled{% endunless %}>
                   {% if current_variant.available %}
                     {% if request.locale.iso_code == 'en' %}Add to cart{% else %}Adaugă în coș{% endif %}
                   {% else %}
                     {% if request.locale.iso_code == 'en' %}Out of stock{% else %}Stoc epuizat{% endif %}
                   {% endif %}
                 </button>
               </form>

            {% endif %}
          </div>
        </div>

      {% endfor %}
    {% else %}
      <p style="text-align:center">{% if request.locale.iso_code == 'en' %}Please select a collection.{% else %}Vă rugăm să selectați o colecție.{% endif %}</p>
    {% endif %}
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const sectionId = "{{ section_id }}";
  const cards = document.querySelectorAll(`.flour-card-${sectionId}`);
  
  const tAddToCart = '{% if request.locale.iso_code == "en" %}Add to cart{% else %}Adaugă în coș{% endif %}';
  const tOutOfStock = '{% if request.locale.iso_code == "en" %}Out of stock{% else %}Stoc epuizat{% endif %}';
  const tAdding = '{% if request.locale.iso_code == "en" %}Adding...{% else %}Se adaugă...{% endif %}';
  const tAdded = '{% if request.locale.iso_code == "en" %}Added!{% else %}Adăugat!{% endif %}';
  const tError = '{% if request.locale.iso_code == "en" %}Error{% else %}Eroare{% endif %}';
  const tYouSave = '{% if request.locale.iso_code == "en" %}You save{% else %}Economisești{% endif %}';
  const tCurrencySuffix = '{% if request.locale.iso_code == "en" %} RON{% else %} lei{% endif %}';

  cards.forEach(card => {
    // 1. Variáns váltás kezelése
    const pills = card.querySelectorAll(`.flour-card__pill-btn-${sectionId}`);
    const input = card.querySelector(`.flour-variant-input-${sectionId}`);
    const priceBox = card.querySelector('[data-price-box]');
    const submitBtn = card.querySelector(`button[type="submit"]`);

    if(pills.length > 0) {
      pills.forEach(pill => {
        pill.addEventListener('click', function(e) {
          e.preventDefault(); 
          
          pills.forEach(p => p.classList.remove('is-active'));
          this.classList.add('is-active');

          const newId = this.getAttribute('data-variant-id');
          const isAvailable = this.getAttribute('data-available') === 'true';
          
          if(input) input.value = newId;

          if(submitBtn) {
            submitBtn.disabled = !isAvailable;
            submitBtn.textContent = isAvailable ? tAddToCart : tOutOfStock;
          }

          const price = this.getAttribute('data-price');
          const compare = this.getAttribute('data-compare');
          const rawPrice = parseInt(this.getAttribute('data-raw-price'));
          const rawCompare = this.getAttribute('data-raw-compare') ? parseInt(this.getAttribute('data-raw-compare')) : 0;

          if(priceBox) {
            if(rawCompare > rawPrice) {
               const savings = rawCompare - rawPrice;
               const savingsRounded = Math.ceil(savings / 100) * 100;
               const savingsFormatted = (savingsRounded / 100).toFixed(2).replace('.', ',') + tCurrencySuffix;

               priceBox.innerHTML = `
                 <span class="flour-card__compare-${sectionId}">${compare}</span>
                 <span class="flour-card__price-${sectionId}">${price}</span>
                 <span class="flour-card__badge-${sectionId}">${tYouSave} ${savingsFormatted.replace(',00', '')}</span>
               `;
            } else {
               priceBox.innerHTML = `<span class="flour-card__price-${sectionId}">${price}</span>`;
            }
          }
        });
      });
    }

    // 2. KOSÁRBA HELYEZÉS (AJAX + IKON FRISSÍTÉS)
    const form = card.querySelector(`.flour-product-form-${sectionId}`);
    if(form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const btn = form.querySelector('button[type="submit"]');
        const originalText = btn.textContent;
        btn.textContent = tAdding;
        btn.disabled = true;

        const formData = new FormData(form);

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          
          // KOSÁR IKON FRISSÍTÉS LEKÉRÉSE
          fetch(window.Shopify.routes.root + '?sections=cart-icon-bubble')
            .then(res => res.json())
            .then(sections => {
              const cartIconBubble = document.getElementById('cart-icon-bubble');
              const cartIconBubbleMobile = document.getElementById('cart-icon-bubble-mobile');
              
              if (cartIconBubble && sections['cart-icon-bubble']) {
                 cartIconBubble.innerHTML = sections['cart-icon-bubble'];
              }
              if (cartIconBubbleMobile && sections['cart-icon-bubble']) {
                 cartIconBubbleMobile.innerHTML = sections['cart-icon-bubble'];
              }
            })
            .catch(e => console.error("Ikon frissítési hiba:", e));

          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: data } }));
          
          const cartNotification = document.querySelector('cart-notification');
          if (cartNotification) cartNotification.open();

          btn.textContent = tAdded;
          setTimeout(() => {
            btn.textContent = originalText;
            btn.disabled = false;
          }, 2000);
        })
        .catch((error) => {
          console.error('Error:', error);
          btn.textContent = tError;
          setTimeout(() => {
             btn.textContent = originalText;
             btn.disabled = false;
          }, 2000);
        });
      });
    }
  });
});
</script>

{% schema %}
{
  "name": "Grid Pachete Faina 1400px",
  "settings": [
    {
      "type": "collection",
      "id": "collection_handle",
      "label": "Alege Colecția"
    }
  ],
  "presets": [
    {
      "name": "Grid Pachete Faina 1400px"
    }
  ]
}
{% endschema %}
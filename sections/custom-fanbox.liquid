{{ 'component-cart.css' | asset_url | stylesheet_tag }}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

/* FANBOX STÍLUSOK */
#fanbox-modal { position: fixed; inset: 0; z-index: 99999; display: none; }
.fanbox-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
.fanbox-modal-box { position: relative; width: 92%; max-width: 1000px; height: 85vh !important; background: white; margin: 40px auto; border-radius: 12px; border: 1px solid #000; display: flex; flex-direction: column; overflow: hidden; }
.fanbox-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid #e5e5e5; }
#fanbox-close { font-size: 26px; background: none; border: none; cursor: pointer; padding: 6px 12px; }
.fanbox-body-scroll { flex: 1; overflow-y: auto; padding: 15px 20px; }
.fanbox-filters { display: flex; gap: 10px; margin-bottom: 10px; }
.fanbox-select, .fanbox-search { width: 100%; padding: 10px; border: 1px solid #ccc; }
.fanbox-body { display: flex; gap: 15px; height: auto; }
#fanbox-list { width: 42%; overflow-y: auto; border-right: 1px solid #eee; padding-right: 8px; }
#fanbox-map { width: 60%; height: 400px !important; min-height: 400px; background: #f2f2f2; }
.fanbox-list-item { padding: 12px; border-bottom: 1px solid #eee; cursor: pointer; line-height: 1.4; }
.fanbox-list-item:hover { background: #f7f7f7; }

@media (max-width: 749px) {
  .fanbox-body { flex-direction: column; }
  #fanbox-list, #fanbox-map { width: 100%; height: 50%; border-right: none; padding-right: 0; }
  .fanbox-filters { flex-direction: column; }
}
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div id="fanbox-container" style="max-width: 600px; margin: 0 auto;">
    
    <h3 class="h6" style="margin-bottom: 15px; font-weight: bold;">Szállítási opciók</h3>

    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
      <input type="checkbox" id="fanbox-enable" form="cart"
        {% if cart.attributes.fan_pickup != blank %}checked{% endif %}
      >
      Doresc livrare la FanBox
    </label>

    <button
      type="button"
      id="open-fanbox-modal"
      class="button button--secondary"
      style="width:100%; margin-top:10px; display:none;"
    >
      Selectează FanBox
    </button>

    <input type="hidden"
           id="fanbox-selected"
           name="attributes[fan_pickup]"
           form="cart"
           value="{{ cart.attributes.fan_pickup }}">
  </div>
</div>

<div id="fanbox-modal">
  <div class="fanbox-overlay"></div>
  <div class="fanbox-modal-box">
    <div class="fanbox-header">
      <h3>Selectează FanBox / Punct FAN</h3>
      <button id="fanbox-close">×</button>
    </div>
    <div class="fanbox-body-scroll">
      <div class="fanbox-filters">
        <select id="fanbox-county" class="fanbox-select"><option value="">Alege județul…</option></select>
        <select id="fanbox-locality" class="fanbox-select" disabled><option value="">Alege localitatea…</option></select>
      </div>
      <input id="fanbox-search" type="text" class="fanbox-search" placeholder="Filtru după nume punct…">
      <div class="fanbox-body">
        <div id="fanbox-list"></div>
        <div id="fanbox-map"></div>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const modal = document.getElementById("fanbox-modal");
  const openBtn = document.getElementById("open-fanbox-modal");
  const closeBtn = document.getElementById("fanbox-close");
  const fanboxEnable = document.getElementById("fanbox-enable");
  const fanboxHidden = document.getElementById("fanbox-selected");

  const listEl = document.getElementById("fanbox-list");
  const searchInput = document.getElementById("fanbox-search");
  const countySelect = document.getElementById("fanbox-county");
  const localitySelect = document.getElementById("fanbox-locality");

  let map;
  let markers = [];
  let fanPoints = [];
  let filteredPoints = [];
  const proxyURL = "https://api.biruintaolteniei.ro/fan-proxy.php";

  // UI Sync logic
  function refreshUI() {
    if (fanboxEnable.checked) {
      openBtn.style.display = "block";
      if (fanboxHidden.value) {
        const p = fanboxHidden.value.split(" | ");
        // Biztonsági ellenőrzés, ha a split nem sikerült
        if(p.length > 2) {
           openBtn.textContent = `Selectat: ${p[2]} – ${p[1]}`;
        } else {
           openBtn.textContent = "Selectat: " + fanboxHidden.value;
        }
      } else {
        openBtn.textContent = "Selectează FanBox";
      }
    } else {
      openBtn.style.display = "none";
      fanboxHidden.value = "";
      // Aszinkron frissítés, hogy a cart attribútum törlődjön
      fetch("/cart/update.js", {
        method: "POST",
        headers:{"Content-Type":"application/json"},
        body: JSON.stringify({ attributes:{ fan_pickup:"" } })
      });
    }
  }

  if(fanboxEnable) {
      fanboxEnable.addEventListener("change", refreshUI);
      refreshUI();
  }

  // Modal logic
  if(openBtn) {
      openBtn.addEventListener("click", () => {
        modal.style.display = "block";
        if (!fanPoints.length) loadPoints();
        safeInvalidate();
      });
  }

  if(closeBtn) {
      closeBtn.addEventListener("click", () => {
        modal.style.display = "none";
      });
  }

  // Map functions
  function safeInvalidate() {
    if (!map) return;
    setTimeout(() => map.invalidateSize(), 80);
    setTimeout(() => map.invalidateSize(), 240);
  }

  async function loadPoints() {
    try {
        const res = await fetch(proxyURL);
        const json = await res.json();
        fanPoints = json.data.filter(p => p.name.toLowerCase().includes("(locker"));
        initMap();
        buildCountyDropdown();
    } catch(e) {
        console.error("FanBox API error:", e);
    }
  }

  function initMap() {
    if(map) return;
    map = L.map("fanbox-map").setView([45.94, 25], 6);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png").addTo(map);
  }

  function buildCountyDropdown() {
    const counties = [...new Set(fanPoints.map(p => p.county))].sort();
    counties.forEach(c => {
      if (!c) return;
      const opt = document.createElement("option");
      opt.value = c.trim();
      opt.textContent = c.trim();
      countySelect.appendChild(opt);
    });
    countySelect.addEventListener("change", onCountyChange);
    localitySelect.addEventListener("change", onLocalityChange);
  }

  function onCountyChange() {
    const c = countySelect.value;
    localitySelect.innerHTML = '<option value="">Alege localitatea…</option>';
    localitySelect.disabled = !c;
    searchInput.value = "";
    clearMarkers();
    listEl.innerHTML = "";
    map.setView([45.94,25],6);
    if (!c) return;
    const locs = [...new Set(fanPoints.filter(p => p.county === c).map(p => p.locality))].sort();
    locs.forEach(l => {
      const opt = document.createElement("option");
      opt.value = l;
      opt.textContent = l;
      localitySelect.appendChild(opt);
    });
  }

  function onLocalityChange() {
    const c = countySelect.value;
    const l = localitySelect.value;
    if (!c || !l) return;
    filteredPoints = fanPoints.filter(p => p.county === c && p.locality === l);
    renderList(filteredPoints);
    showMarkers(filteredPoints);
    zoomTo(filteredPoints);
  }

  searchInput.addEventListener("input", () => {
    const t = searchInput.value.toLowerCase();
    const res = filteredPoints.filter(p => p.name.toLowerCase().includes(t) || p.address.toLowerCase().includes(t));
    renderList(res);
    showMarkers(res.length ? res : filteredPoints);
    if (res.length) zoomTo(res);
  });

  function renderList(arr) {
    listEl.innerHTML = "";
    arr.forEach(p => {
      const div = document.createElement("div");
      div.className = "fanbox-list-item";
      div.textContent = `${p.locality} – ${p.name}`;
      div.addEventListener("click", () => selectPoint(p));
      listEl.appendChild(div);
    });
  }

  function clearMarkers() {
    markers.forEach(m => map.removeLayer(m));
    markers = [];
  }

  function showMarkers(arr) {
    clearMarkers();
    arr.forEach(p => {
      const m = L.marker([p.latitude, p.longitude], { autoPan: false }).addTo(map);
      m.bindPopup(p.name, { autoPan: false });
      m.on("click", () => selectPoint(p));
      markers.push(m);
    });
  }

  function zoomTo(arr) {
    const b = L.latLngBounds(arr.map(p => [p.latitude, p.longitude]));
    map.fitBounds(b, { padding:[20,20] });
  }

  function selectPoint(p) {
    const val = `${p.id} | ${p.name} | ${p.locality} | ${p.address}`;
    fanboxHidden.value = val;
    // AJAX frissítés a háttérben
    fetch("/cart/update.js", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({ attributes:{ fan_pickup:val } })
    });
    
    // UI frissítés
    refreshUI();
    modal.style.display = "none";
  }
});
</script>

{% schema %}
{
  "name": "FanBox Selector",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Felső térköz",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Alsó térköz",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "FanBox Selector"
    }
  ]
}
{% endschema %}
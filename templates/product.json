        "custom_liquid_qMexka": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% if request.locale.iso_code == 'en' %}\n<script>\n  (function() {\n    // 1. Regex alapú szótár: a szögletes zárójelek közötti betűk bármelyikét elfogadja, \n    // az 'i' a végén pedig kikapcsolja a kis/nagybetű érzékenységet.\n    const translations = [\n      { regex: /Produse frecvent cumpărate împreună/i, replace: \"Frequently bought together\" },\n      { regex: /Produsele selectate vor fi adăugate în coș/i, replace: \"The selected products will be added to the cart.\" },\n      { regex: /Adaugă produsele selectate în coș/i, replace: \"Add selected products to cart\" },\n      { regex: /Acest produs:/i, replace: \"This product:\" },\n      // Terméknevek rugalmas kereséssel (ékezetes és ékezet nélküli verziókat is megfogja)\n      { regex: /F[ăaâ]in[ăa] integral[ăa] de gr[âaă]u/i, replace: \"WHOLE WHEAT Flour\" },\n      { regex: /F[ăaâ]in[ăa] integral[ăa] de sec[ăa]r[ăa]/i, replace: \"WHOLE RYE Flour\" },\n      { regex: /T[ăa]r[âa]țe integrale de gr[âa]u/i, replace: \"Whole Wheat Bran\" }\n    ];\n\n    // 2. A függvény, ami megkeresi és kicseréli a szövegeket\n    function translateAppText() {\n      const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);\n      let node;\n      while ((node = walk.nextNode())) {\n        translations.forEach(item => {\n          // Ha a regex minta illeszkedik a szövegre, cseréljük\n          if (item.regex.test(node.nodeValue)) {\n            node.nodeValue = node.nodeValue.replace(item.regex, item.replace);\n          }\n        });\n      }\n    }\n\n    // 3. Lefuttatjuk azonnal, ha már betöltött valami\n    document.addEventListener('DOMContentLoaded', translateAppText);\n    \n    // 4. MutationObserver: Figyeli az oldalt az utólag betöltődő elemek miatt\n    const observer = new MutationObserver(function(mutations) {\n      translateAppText();\n    });\n    \n    observer.observe(document.body, { childList: true, subtree: true });\n    \n    // 5. SEO / Teljesítmény védelem: 4 másodperc után leállítjuk a figyelést\n    setTimeout(function() {\n      observer.disconnect();\n    }, 4000);\n  })();\n</script>\n{% endif %}"
          }
        },

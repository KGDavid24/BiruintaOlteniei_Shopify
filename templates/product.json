        "custom_liquid_XMzrHb": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .custom-pdf-container {\n    margin: 15px 0;\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .pdf-download-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background-color: #F2AC29;\n    color: #ffffff;\n    padding: 10px 20px; \n    border-radius: 10px;\n    text-decoration: none;\n    font-weight: 700;\n    font-size: 1.4rem;\n    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;\n    border: 2px solid #F2AC29;\n    cursor: pointer;\n    line-height: 1.2;\n    width: fit-content;\n  }\n\n  .pdf-download-button:hover {\n    background-color: #ffffff;\n    color: #F2AC29;\n    border: 1px solid #F2AC29;\n  }\n\n  .button-icon {\n    margin-right: 10px;\n    display: flex;\n    align-items: center;\n  }\n\n  .button-icon svg {\n    width: 24px;\n    height: 24px;\n    fill: currentColor;\n  }\n</style>\n\n<div class=\"custom-pdf-container\">\n  \n  {% assign product_title = product.title | downcase %}\n  {% assign product_handle = product.handle | downcase %}\n\n  {%- comment -%} EZ A GOMB MINDIG MEGJELENIK {%- endcomment -%}\n  <a href=\"https://cdn.shopify.com/s/files/1/0868/5217/4102/files/Analize_Biruinta_Olteniei.pdf?v=1763139226\" \n     target=\"_blank\" \n     class=\"pdf-download-button\">\n    <span class=\"button-icon\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/>\n      </svg>\n    </span>\n    <span class=\"button-text\">\n      {% if request.locale.iso_code == 'en' %}\n        Biruinta Olteniei Analysis\n      {% else %}\n        Analize Biruinta Olteniei\n      {% endif %}\n    </span>\n  </a>\n\n  {%- comment -%} FŐ FELTÉTEL: Ha PREMIUM, akkor ez is megjelenik {%- endcomment -%}\n  {% if product_title contains 'premium' or product_handle contains 'premium' %}\n  \n    <a href=\"https://cdn.shopify.com/s/files/1/0868/5217/4102/files/Analize_faina_alba_PREMIUM.pdf?v=1770892454\" \n       target=\"_blank\" \n       class=\"pdf-download-button\">\n      <span class=\"button-icon\">\n        <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/>\n        </svg>\n      </span>\n      <span class=\"button-text\">\n        {% if request.locale.iso_code == 'en' %}\n          PREMIUM White Flour Analysis\n        {% else %}\n          Analize faina alba PREMIUM\n        {% endif %}\n      </span>\n    </a>\n\n  {% else %}\n    \n    {%- comment -%} HA NEM PREMIUM: Akkor ellenőrizzük a többit {%- endcomment -%}\n    \n    {% if product_title contains 'grâu' or product_title contains 'wheat' or product_handle contains 'grau' %}\n      <a href=\"https://cdn.shopify.com/s/files/1/0868/5217/4102/files/Analize_faina_integrala_de_GRAU.pdf?v=1770892455\" \n         target=\"_blank\" \n         class=\"pdf-download-button\">\n        <span class=\"button-icon\">\n          <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/>\n          </svg>\n        </span>\n        <span class=\"button-text\">\n          {% if request.locale.iso_code == 'en' %}\n            WHOLE WHEAT Flour Analysis\n          {% else %}\n            Analize faina integrala de GRAU\n          {% endif %}\n        </span>\n      </a>\n    {% endif %}\n\n    {% if product_title contains 'secară' or product_title contains 'rye' or product_handle contains 'secara' %}\n      <a href=\"https://cdn.shopify.com/s/files/1/0868/5217/4102/files/Analize_faina_integrala_de_SECARA.pdf?v=1770892454\" \n         target=\"_blank\" \n         class=\"pdf-download-button\">\n        <span class=\"button-icon\">\n          <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/>\n          </svg>\n        </span>\n        <span class=\"button-text\">\n          {% if request.locale.iso_code == 'en' %}\n            WHOLE RYE Flour Analysis\n          {% else %}\n            Analize faina integrala de SECARA\n          {% endif %}\n        </span>\n      </a>\n    {% endif %}\n\n  {% endif %}\n\n</div>"

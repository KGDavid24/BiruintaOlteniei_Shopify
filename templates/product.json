        "custom_liquid_ydNYtE": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\nDawn variant-aware “Economisești / You save” box (no prices shown)\nPaste into a Product template \"Custom liquid\" block.\nUpdates on variant change.\n{%- endcomment -%}\n\n{%- liquid\n  assign v = product.selected_or_first_available_variant\n  assign price = v.price | default: product.price\n  assign compare = v.compare_at_price | default: product.compare_at_price\n\n  assign has_discount = false\n  if compare and compare > price\n    assign has_discount = true\n    assign savings = compare | minus: price\n  endif\n-%}\n\n<style>\n  .economisesti-box {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    padding: 10px 14px;\n    border-radius: 10px;\n    background: #f7d9dd; /* light pink */\n    color: #b3132c;      /* red */\n    font-weight: 800;\n    line-height: 1.2;\n    margin: 10px 0;\n  }\n  .economisesti-box[hidden] { display: none !important; }\n</style>\n\n<div\n  id=\"economisesti-{{ section.id | default: 'custom-liquid' }}\"\n  class=\"economisesti-box\"\n  {% unless has_discount %}hidden{% endunless %}\n  role=\"status\"\n  aria-live=\"polite\"\n>\n  <span class=\"economisesti-box__text\">\n    {% if request.locale.iso_code == 'en' %}You save{% else %}Economisești{% endif %} <span data-economisesti-amount>{{ savings | default: 0 | money }}</span>\n  </span>\n</div>\n\n<script>\n(() => {\n  const box = document.getElementById('economisesti-{{ section.id | default: 'custom-liquid' }}');\n  if (!box) return;\n\n  const amountEl = box.querySelector('[data-economisesti-amount]');\n  const variants = {{ product.variants | json }};\n\n  function getCurrentVariantId() {\n    // Dawn keeps a hidden input[name=\"id\"] inside the product form\n    const form = box.closest('section')?.querySelector('form[action*=\"/cart/add\"]')\n      || document.querySelector('form[action*=\"/cart/add\"]');\n    const idInput = form?.querySelector('input[name=\"id\"]');\n    const id = idInput?.value;\n\n    // Fallback: try URL ?variant=\n    if (id) return Number(id);\n    const urlId = new URL(window.location.href).searchParams.get('variant');\n    return urlId ? Number(urlId) : null;\n  }\n\n  function moneyFromCents(cents) {\n    // We let Shopify render money format via a tiny trick: reuse server-rendered money for 0 and replace number.\n    // More robust: format as RON with Intl if available.\n    try {\n      const locale = document.documentElement.lang || 'ro-RO';\n      // Shopify prices are integer cents\n      return new Intl.NumberFormat(locale, { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' })\n        .format((cents || 0) / 100);\n    } catch (e) {\n      // Simple fallback (assumes 2 decimals)\n      const val = ((cents || 0) / 100).toFixed(2).replace('.', ',');\n      return val + ' {{ cart.currency.iso_code | default: shop.currency }}';\n    }\n  }\n\n  function updateEconomisesti(variantId) {\n    const v = variants.find(x => Number(x.id) === Number(variantId));\n    if (!v) {\n      box.hidden = true;\n      return;\n    }\n\n    const price = Number(v.price || 0);\n    const compare = Number(v.compare_at_price || 0);\n\n    if (compare > price) {\n      const savings = compare - price;\n      amountEl.textContent = moneyFromCents(savings);\n      box.hidden = false;\n    } else {\n      box.hidden = true;\n    }\n  }\n\n  // Initial\n  updateEconomisesti(getCurrentVariantId());\n\n  // 1) Dawn (and many themes) emit variant:change\n  document.addEventListener('variant:change', (e) => {\n    const id = e?.detail?.variant?.id || getCurrentVariantId();\n    updateEconomisesti(id);\n  });\n\n  // 2) Some Dawn versions publish a custom event on change\n  document.addEventListener('variantChange', (e) => {\n    const id = e?.detail?.variant?.id || getCurrentVariantId();\n    updateEconomisesti(id);\n  });\n\n  // 3) Generic fallback: listen to any change inside the product form\n  document.addEventListener('change', (e) => {\n    const target = e.target;\n    if (!target) return;\n    const form = target.closest?.('form[action*=\"/cart/add\"]');\n    if (!form) return;\n    // give Dawn time to update the hidden variant id\n    setTimeout(() => updateEconomisesti(getCurrentVariantId()), 0);\n  });\n\n  // 4) URL variant param changes (some themes update history)\n  const _pushState = history.pushState;\n  history.pushState = function() {\n    _pushState.apply(this, arguments);\n    setTimeout(() => updateEconomisesti(getCurrentVariantId()), 0);\n  };\n  window.addEventListener('popstate', () => {\n    setTimeout(() => updateEconomisesti(getCurrentVariantId()), 0);\n  });\n})();\n</script>"
          }

    "custom_liquid_mL8HKK": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Făina voastră are în compoziție „cenușă”?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da. Orice făină are „cenușă”, adică reziduul mineral. La Biruința Olteniei, făina albă PREMIUM este Tip 650, ceea ce înseamnă un conținut de cenușă de maximum 0,65%, raportat la substanța uscată.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce înseamnă făină Tip 650?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Tip 650 este o clasificare a făinii de grâu în funcție de conținutul de cenușă, adică de minerale. Pentru Tip 650, limita este de maximum 0,65% cenușă, raportat la substanța uscată.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Care este procentul de proteină la făina voastră?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Făina albă de grâu PREMIUM are 15% proteină, făina integrală de grâu are 13,8% proteină, iar făina integrală de secară are 13% proteină.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"De ce este relevant procentul de proteină la făină și ce indică el?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Procentul de proteină arată, în mare, cât de bine poate lega aluatul. Mai multă proteină înseamnă, de regulă, un aluat mai elastic și mai stabil, bun pentru pâine, pizza sau cozonac. Totuși, contează și tipul de grâu și modul în care lucrezi aluatul, deci nu este singurul criteriu.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Cerealele folosite la moara de la Biruința Olteniei au pesticide?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru probe de grâu și secară din 2025, rezultatul pentru reziduuri de pesticide este sub limita de cuantificare, cu concluzie de conformitate raportată la Regulamentul (CE) nr. 396/2005.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce înseamnă < LOQ la analize?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Înseamnă „sub limita de cuantificare”, adică s-a analizat, dar valoarea este atât de mică încât se află sub pragul la care laboratorul o poate măsura precis.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Care sunt produsele de la Biruința Olteniei?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"În gamă se găsesc făină albă PREMIUM, făină integrală de grâu, făină integrală de secară, tărâțe integrale de grâu și pachete cu combinații de grâu și secară.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Aveți și tărâțe? La ce sunt bune?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da, există tărâțe integrale de grâu. Pot fi folosite în pâine, în cantități mici, dar și în granola, iaurt sau în alte rețete pentru un plus de fibre.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Unde aveți moara?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Moara Cooperativei Agricole Biruința Olteniei este în Dobrun, sat Ulmet, județul Olt.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Cum păstrez făina ca să nu prindă miros sau umiditate?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Păstrează făina într-un recipient închis, la loc uscat și răcoros. Ideal este să nu stea lângă condimente puternice sau în spații umede.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce termen de valabilitate are făina?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Termenul exact de valabilitate este indicat pe ambalaj. După deschidere, recomandarea practică este să fie păstrată bine închisă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Unde găsim făina de la Biruința Olteniei?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Făina poate fi comandată online direct de pe site-ul biruintaolteniei.ro. În București este disponibilă și în Băcănia Veche.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"În ce băcănii și magazine sunteți în țară?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Momentan, produsele sunt prezente în Băcănia Veche din București.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Livrați făină în toată țara?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da, livrăm în toată țara.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"În cât timp ajunge comanda de făină?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Conform politicii de expediere, comanda ajunge în aproximativ 3 zile, după confirmarea comenzii și în funcție de stoc.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Pot plăti cu cardul când fac o comandă?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da, poți plăti cu cardul folosind metode uzuale, precum Visa și Mastercard.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Pot plăti ramburs când comand de pe site?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da, există și opțiunea de plată ramburs.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce fac dacă mi-a ajuns coletul deteriorat?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Dacă pachetul a ajuns deteriorat, trimiteți un mesaj cu poze și situația va fi rezolvată.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Vreau să fac o comandă, dar nu mă descurc să comand online. Cum procedez?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Comanda poate fi plasată și telefonic cu ajutorul echipei. Pentru asistență, sunați la 0778 748 196, de luni până vineri, în intervalul 09:00–16:00.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Vreau să fac cozonaci. Ce făină îmi recomandați?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru cozonaci este recomandată făina albă de grâu PREMIUM, potrivită pentru cozonaci, aluaturi fine și produse de patiserie.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Vreau să fac pizza. Ce făină îmi recomandați?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru pizza clasică se recomandă făina albă de grâu PREMIUM, cu 15% proteină. Pentru o pizza cu aromă mai rustică, este recomandată făina integrală de grâu.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Făina voastră e bună pentru paste (tăiței)?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da. Pentru tăiței și paste de casă pot fi folosite atât făina integrală de grâu, cât și făina albă de grâu PREMIUM Tip 650. Dacă se dorește o culoare mai galbenă la tăiței, se pot folosi mai multe ouă sau un amestec cu mai puțină făină integrală.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce făină recomandați pentru clătite și pancakes?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru clătite și pancakes se poate folosi făina albă de grâu PREMIUM Tip 650. Pentru un gust mai intens de cereale, se poate face și un amestec de 50% făină integrală și 50% făină Tip 650.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce făină recomandați pentru plăcinte, chec și pandișpan?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Făina albă de grâu PREMIUM Tip 650 este potrivită pentru majoritatea aluaturilor de casă. Pentru pandișpan foarte fin contează mult și tehnica, mai ales cum sunt bătute ouăle, nu doar tipul de făină.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce făină recomandați pentru pâine de casă?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru pâine de casă sunt recomandate făina integrală de grâu și făina integrală de secară.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce făină recomandați pentru pâine cu maia?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru pâine cu maia sunt recomandate în special făina integrală de grâu și făina integrală de secară.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Făina e potrivită pentru maia (sourdough)?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da. Făina merge foarte bine și pentru maia, mai ales dacă sunt respectați timpii de fermentație și hidratarea potrivită, în special la făinurile integrale.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Pot face pâine 100% integrală cu făina voastră?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da. Mulți clienți folosesc făina integrală pentru pâine 100% integrală. Ajută mult o hidratare mai mare, autoliza și o fermentație mai lungă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"La ce e bună făina integrală de secară?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Făina integrală de secară este folosită mai ales pentru pâine și pizza. Este foarte bună pentru pâini cu aromă intensă, crackers și turte, dar și în amestec cu grâu, de exemplu în proporție de 10–30%, pentru gust și umiditate.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Aveți o rețetă pentru făina de secară?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da. Orice rețetă clasică cu secară este potrivită și pentru făina integrală de secară de la Biruința Olteniei.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Care e diferența între făina albă și făina integrală?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Făina integrală include și tărâța și germenele, de aceea are un gust mai plin și cere, de regulă, mai multă apă și mai mult timp de hidratare decât făina albă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"De ce cere făina integrală mai multă apă?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru că tărâța absoarbe multă apă. Din acest motiv, aluatul are nevoie de hidratare mai mare și de timp de repaus, cum ar fi autoliza sau pauzele între frământări.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce este autoliza și de ce contează la făina integrală?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Autoliza este etapa în care se amestecă făina cu apa și se lasă la odihnă 20–60 de minute înainte de a adăuga sarea și drojdia sau maiaua. Ajută la hidratare și la formarea structurii aluatului. La făina integrală este importantă deoarece tărâța absoarbe multă apă, iar aluatul se stabilizează mai bine după repaus.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Care sunt cauzele pentru care aluatul pentru pâine nu crește și ce poți face?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"La făina integrală, mai ales una fără amelioratori sau aditivi, cum este făina Biruința Olteniei, pot fi necesari timpi mai buni de frământare și dospire decât la făinurile industriale. În general, este important să verifici drojdia sau maiaua să fie activă, temperatura de dospire, să mărești ușor hidratarea, mai ales la integrală și secară, și să prelungești fermentația.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"De ce aluatul meu e prea lipicios cu făina integrală?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Este normal ca aluatul cu făină integrală să fie mai lipicios la început. Ajută mult autoliza, pauzele între împachetări și lucrul cu mâinile umezite, în loc să se adauge multă făină pe masă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"De ce pâinea cu secară iese „cleioasă” la mijloc?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Secara se comportă diferit față de grâul alb și are mai puțin gluten. De obicei ajută un procent mai mic de secară în amestec, o coacere suficientă și răcirea completă a pâinii înainte de tăiere.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Pot combina Tip 650 cu integrală? În ce proporții?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Da. Făina Tip 650 poate fi combinată cu făina integrală, iar proporția se ajustează în funcție de tipul de pâine dorit și de cât de rustic vrei să iasă rezultatul. Pe măsură ce crește procentul de făină integrală, este util să ajustezi ușor și cantitatea de apă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce pâine este mai potrivită pentru diabet: albă sau integrală?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"În general, pâinea integrală poate avea un impact mai blând decât pâinea albă, datorită fibrelor. Totuși, contează mult porția, rețeta și cu ce este consumată. Pentru recomandări personalizate, este bine să discuți cu medicul sau dieteticianul.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Făina integrală are indice glicemic mai mic?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"De obicei, produsele integrale pot avea un răspuns glicemic mai lent decât cele din făină albă, datorită fibrelor. Totuși, indicele glicemic al pâinii depinde și de procesul de preparare, de exemplu maia versus drojdie, precum și de hidratare, fermentație și coacere.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Pâinea cu maia este mai bună pentru glicemie?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Pentru unii oameni, pâinea cu maia poate fi mai bine tolerată decât pâinea cu dospire rapidă, însă reacția diferă de la persoană la persoană. Cantitatea consumată rămâne foarte importantă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Secara e o opțiune bună pentru pâine?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Secara are un gust intens, iar pâinile cu secară sunt în general mai dense. Mulți aleg să folosească 10–30% secară în amestec cu grâu pentru aromă și textură. Pentru recomandări personalizate, mai ales în diabet, este bine să discuți cu un specialist.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Pâinea integrală înseamnă „fără zahăr” sau „low carb”?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Nu. Pâinea integrală este tot pâine și conține carbohidrați. Diferența este că, de regulă, are mai multe fibre decât pâinea albă.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Ce contează cel mai mult pentru glicemie când mănânc pâine?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"De regulă contează porția, tipul pâinii, de exemplu integrală sau cu maia, combinația din farfurie cu proteine, grăsimi și fibre, dar și momentul zilei. Dacă urmărești glicemia, cel mai util este să observi cum reacționezi tu la diferite tipuri de pâine.\"\n      }\n    }\n  ]\n}\n</script>",
